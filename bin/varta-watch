#!/usr/bin/python3
"""Watch the air raid feed and report what is known, once per poll.

Prints one JSON object per line on stdout, so whatever is reading it — the
shell plugin, a terminal, a script — sees every reading rather than a file it
has to guess the freshness of. If this process dies, its reader notices at once;
that is the point of streaming rather than writing state to disk.

Polite by design. The feed is a free service run by somebody else: it refreshes
its cache about once a minute and rate-limits hard (a burst of requests earns a
429, which would keep this blind for longer than simply waiting). So it asks
once a minute, backs off when refused, and identifies itself.
"""
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import pathlib
import signal
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "app"))
from watchcore import Reading, Watch, backoff, plain, plainly  # noqa: E402
from history import Ledger, Transition, trim  # noqa: E402

def history_path() -> pathlib.Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.environ.get("HOME", ""), ".local", "state")
    return pathlib.Path(base) / "varta" / "history.jsonl"


def remember(transitions: list) -> None:
    """Append what changed. Best effort on purpose: a watch that cannot write
    its diary must still watch, so every failure here is swallowed rather than
    allowed to take the poller down with it."""
    if not transitions:
        return
    path = history_path()
    try:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        # O_NOFOLLOW: this lives under the user's own state directory, and a
        # symlink dropped in its place would have us appending somewhere else.
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, ("".join(t.as_line() + "\n" for t in transitions)).encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        return
    try:
        if path.stat().st_size > 2 * 1024 * 1024:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
            tmp = path.with_suffix(".jsonl.new")
            tmp.write_text("\n".join(trim(lines)) + "\n", encoding="utf-8")
            os.replace(tmp, path)
    except OSError:
        pass


def claim(state: pathlib.Path) -> int | None:
    """The right to keep the reading at `state`: one watcher per file, so two
    widgets never poll the feed twice. None when another watcher has it."""
    state.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = os.lstat(state.parent)
    if not os.path.isdir(state.parent) or os.path.islink(state.parent) or info.st_uid != os.getuid():
        raise SystemExit(f"{state.parent} is not a private directory of ours")
    fd = os.open(f"{state}.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def publish(state: pathlib.Path, line: str) -> None:
    """The latest reading, replaced whole, for a reader that cannot stream (a
    Plasma widget). Never through a link, never half written."""
    tmp = state.with_name(f".{state.name}.{os.getpid()}.tmp")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            os.write(fd, (line + "\n").encode("utf-8"))
        finally:
            os.close(fd)
        os.replace(tmp, state)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def die_with_parent() -> None:
    """Ask the kernel to kill this process when whoever started it goes away.

    The shell spawns this and streams its output; if the shell is killed
    outright, a poller left behind would go on asking somebody else's server
    for alerts forever, with nothing reading the answers.
    """
    try:
        import ctypes
        PR_SET_PDEATHSIG = 1
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(
            PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0)
    except Exception:
        pass  # a leash we could not fasten is not a reason to refuse to watch


FEED = "https://ubilling.net.ua/aerialalerts/"
AGENT = "omarchy-varta/1.0 (+https://github.com/ReidenXerx/omarchy-varta)"
TIMEOUT = 15
# The feed answers in about 4 KB. Anything wildly larger is not the feed.
CEILING = 256 * 1024


def fetch(url: str) -> tuple[frozenset[str], dt.datetime | None, list[str]]:
    """One request, everything the caller could want from it.

    One request, because asking twice for the same page is how a caller earns
    the 429 it then has to wait out.
    """
    request = urllib.request.Request(url, headers={
        "User-Agent": AGENT,
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            if response.status != 200:
                raise RuntimeError(f"HTTP {response.status}")
            raw = response.read(CEILING + 1)
    except urllib.error.HTTPError as problem:
        if problem.code == 429:
            raise RuntimeError("feed refused us for asking too often (429)") from None
        raise RuntimeError(f"HTTP {problem.code}") from None
    if len(raw) > CEILING:
        raise RuntimeError("response too large to be the feed")

    payload = json.loads(raw.decode("utf-8"))
    states = payload.get("states")
    if not isinstance(states, dict) or not states:
        raise RuntimeError("feed carried no regions")

    # Names are flattened once, here, so that everything downstream — the
    # matching, the bar, the band — works on the same safe strings.
    states = {plain(name): value for name, value in states.items()
              if isinstance(name, str) and plain(name)}
    if not states:
        raise RuntimeError("feed carried no usable region names")

    alerting = frozenset(
        name for name, value in states.items()
        if isinstance(value, dict) and value.get("alertnow") is True
    )

    # The cache stamp is local Kyiv time, without an offset.
    source_time = None
    stamp = payload.get("cachedat")
    if isinstance(stamp, str):
        try:
            naive = dt.datetime.strptime(stamp, "%Y-%m-%d %H:%M:%S")
            source_time = naive.astimezone()
        except ValueError:
            source_time = None
    return alerting, source_time, sorted(states)


def clocks() -> tuple[float, float]:
    """Awake time, and wall-of-the-machine time.

    CLOCK_MONOTONIC stops while the machine is suspended and CLOCK_BOOTTIME does
    not, so the difference between how much each advanced is exactly how long
    the lid was shut.
    """
    return (time.clock_gettime(time.CLOCK_MONOTONIC),
            time.clock_gettime(time.CLOCK_BOOTTIME))


def run(region: str, others: tuple[str, ...], every: int, once: bool,
        feed: str = FEED, state: pathlib.Path | None = None) -> int:
    watch = Watch(region=region, others=others)
    # Remembers only what it last saw per region, so a restart costs nothing
    # and invents nothing.
    ledger = Ledger()
    known: list[str] = []
    awake, booted = clocks()
    while True:
        now_awake, now_booted = clocks()
        # A laptop that slept has not "lost the feed" — it has just woken up,
        # and its network usually has not. Saying so lets the shell hold its
        # tongue for a moment instead of crying wolf every single morning.
        slept = (now_booted - booted) - (now_awake - awake)
        awake, booted = now_awake, now_booted
        now = dt.datetime.now(dt.timezone.utc)
        try:
            alerting, source_time, names = fetch(feed)
            watch.observe(Reading(fetched_at=now, source_time=source_time, alerting=alerting))
            known = names
            error = None
        except Exception as problem:            # any failure is the same to a reader
            watch.failed(now)
            error = f"{type(problem).__name__}: {problem}"[:200]

        # What changed since the last poll, for the history. Only recorded while
        # the watch can actually see: a blind poller writing "clear" would invent
        # the end of an alert that may still be running.
        snap_at = dt.datetime.now(dt.timezone.utc)
        line = watch.snapshot(snap_at)
        if line.get("alert") is not None:
            changes = [t for t in (
                [ledger.observe(line.get("region", ""), bool(line["alert"]), snap_at)]
                + [ledger.observe(a.get("region", ""), bool(a.get("alert")), snap_at)
                   for a in (line.get("also") or []) if a.get("alert") is not None]
            ) if t]
            remember(changes)
        # The regions the feed actually has, so nothing downstream has to keep
        # its own copy of the list and drift from it.
        line["known"] = known
        if slept > 30:
            line["resumed"] = True
            line["slept_s"] = int(slept)
        if error:
            # What a person reads, and what whoever has to fix it reads.
            line["error"] = plainly(error)
            line["detail"] = error
        text = json.dumps(line, ensure_ascii=False)
        print(text, flush=True)
        if state is not None:
            publish(state, text)

        if once:
            return 0 if watch.last_ok else 1
        time.sleep(every if not watch.consecutive_failures
                   else backoff(watch.consecutive_failures, base=every))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--region", help="where you are, exactly as the feed names it")
    parser.add_argument("--also", default="",
                        help="other regions to keep an eye on, comma separated")
    parser.add_argument("--every", type=int, default=60,
                        help="seconds between polls (the feed refreshes about this often)")
    parser.add_argument("--once", action="store_true", help="one reading, then exit")
    parser.add_argument("--list", action="store_true", help="print the region names the feed uses")
    parser.add_argument("--feed", default=FEED,
                        help="where to read from; for proving what happens when it cannot be read")
    parser.add_argument("--state", help="also keep the latest reading in this file (one watcher per file; "
                        "a second one exits with 75)")
    args = parser.parse_args()

    die_with_parent()

    if args.list:
        try:
            alerting, _, names = fetch(args.feed)
        except Exception as problem:
            print(f"could not reach the feed: {problem}", file=sys.stderr)
            return 1
        for name in names:
            print(f"{'ALERT' if name in alerting else '     '}  {name}")
        return 0

    if not args.region:
        parser.error("--region is required (use --list to see the names)")
    if args.every < 30:
        parser.error("polling faster than every 30s gets the feed to refuse us")
    others = tuple(name.strip() for name in args.also.split(",") if name.strip())
    state = None
    if args.state:
        state = pathlib.Path(args.state)
        if not state.is_absolute():
            parser.error("--state must be an absolute path")
        if claim(state) is None:
            print("another watcher keeps this reading", file=sys.stderr)
            return 75
    return run(args.region, others, args.every, args.once, args.feed, state)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
